<?xml version="1.0" encoding="UTF-8"?>
<addons>
    <addon id="plugin.video.reezn.browser"
           name="Reezn Browser"
           version="0.1.0"
           provider-name="OpenAI">
        <requires>
            <import addon="xbmc.python" version="3.0.0"/>
        </requires>
        <extension point="xbmc.python.pluginsource" library="addon.py">
            <provides>video</provides>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">Movie and TV browser for Kodi</summary>
            <description lang="en_GB">A Kodi browsing frontend using TMDB metadata. Playback is limited to authorized/public sources.</description>
            <platform>all</platform>
            <license>GPL-3.0-or-later</license>
        </extension>
    </addon>
</addons>
